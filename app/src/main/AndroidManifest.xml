<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="com.topjohnwu.magisk.debug" />
        <package android:name="com.topjohnwu.magisk.canary" />
        <package android:name="com.topjohnwu.magisk.alpha" />
        <package android:name="io.github.huskydg.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="com.sukisu.ultra" />
        <package android:name="com.resukisu.resukisu" />
        <package android:name="me.bmax.apatch" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="com.noshufou.android.su.elite" />
        <package android:name="com.kingroot.kinguser" />
        <package android:name="com.kingouser.com" />
        <package android:name="me.phh.superuser" />

        <!-- Lets us resolve launch intents for the About → "Other apps" list (Open vs Install). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <!-- Lets us see which app handles a web URL, to detect a site installed as a PWA (WebAPK)
             for a web-only entry in the "Other apps" list. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".BasicRootCheckerApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher_v2"
        android:localeConfig="@xml/app_locales_config"
        android:label="@string/app_name"
        android:theme="@style/Theme.iboalali.Main"
        tools:targetApi="33">

        <!-- Lets Macrobenchmark/simpleperf profile the release build on non-rooted API 29+
             devices. Ignored below API 29; has no effect on normal user builds. -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.iboalali.SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider
            android:name="com.telemetrydeck.sdk.TelemetryDeckInitProvider"
            android:authorities="${applicationId}.telemetrydeckinitprovider"
            tools:node="remove" />

        <!-- AppFunctions (androidx.appfunctions alpha10). The app-level app_metadata carries the
             LLM-facing app description; the entry-point <service> below (generated by the
             @AppFunctionServiceEntryPoint compiler from BaseRootAppFunctionService) carries the
             exposed functions. alpha10 merged the former appfunctions-service artifact into
             androidx.appfunctions, so the service is no longer manifest-merged for us. -->
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />

        <service
            android:name=".appfunctions.RootAppFunctionService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="root_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
