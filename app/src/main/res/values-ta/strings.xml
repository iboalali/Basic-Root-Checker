    <!-- Settings Strings -->
    <string name="settings_telemetry_title">அநாமதேய பயன்பாட்டுத் தரவைப் பகிர்</string>
    <string name="settings_telemetry_description">TelemetryDeck மூலம் ஆப்ஸை மேம்படுத்த உதவுகிறது. இயக்கினால், அடுத்த முறை ஆப்ஸ் தொடங்கும்போது நடைமுறைக்கு வரும்.</string>
    <string name="settings_reset_identity_title">பகுப்பாய்வு அடையாளத்தை மீட்டமை</string>
    <string name="settings_reset_identity_description">புதிய அநாமதேய ID-ஐத் தொடங்குங்கள், இதனால் இனி சேகரிக்கப்படும் பயன்பாட்டுத் தரவை முன்பு பகிர்ந்ததுடன் இணைக்க முடியாது.</string>
    <string name="settings_reset_identity_dialog_message">புதிய அநாமதேய அடையாளங்காட்டி உருவாக்கப்படும். இனி சேகரிக்கப்படும் பயன்பாட்டுத் தரவு, இதற்கு முன் பகிரப்பட்ட எதனுடனும் இணைக்கப்படாது. இதைச் செயல்தவிர்க்க முடியாது.</string>
    <string name="settings_reset_identity_confirm">மீட்டமை</string>
    <string name="settings_reset_identity_done">பகுப்பாய்வு அடையாளம் மீட்டமைக்கப்பட்டது</string>
    <string name="settings_haptics_title">அதிர்வு பின்னூட்டம்</string>
    <string name="settings_haptics_description">தட்டும்போது, ரூட் சரிபார்க்கும்போது, முடிவு தோன்றும்போது அதிரும்.</string>
    <string name="settings_privacy_policy_description">எங்கள் தனியுரிமைக் கொள்கையை ஆன்லைனில் பார்க்கவும்</string>
    <string name="settings_theme_title">தீம்</string>
    <string name="theme_follow_system">சிஸ்டம் அமைப்பைப் பின்பற்று</string>
    <string name="theme_light">வெளிர்</string>
    <string name="theme_dark">அடர்</string>
    <string name="settings_language_title">மொழி</string>
    <string name="language_system_default">சிஸ்டம் இயல்புநிலை</string>
    <string name="settings_tip_jar_title">மேம்பாட்டை ஆதரி</string>
    <string name="settings_tip_jar_description">ஆப்ஸ் உங்களுக்கு உதவியிருந்தால் ஒரு டிப் கொடுங்கள்.</string>
    <string name="tip_jar_dialog_title">டிப் கொடுங்கள்</string>
    <string name="tip_tier_small">சிறிய டிப்</string>
    <string name="tip_tier_medium">நடுத்தர டிப்</string>
    <string name="tip_tier_large">பெரிய டிப்</string>
    <string name="tip_jar_loading">டிப் விருப்பங்கள் ஏற்றப்படுகின்றன…</string>
    <string name="tip_jar_thanks">உங்கள் ஆதரவுக்கு நன்றி!</string>
    <string name="tip_jar_pending">உங்கள் டிப் நிலுவையில் உள்ளது. உங்கள் கட்டணம் அங்கீகரிக்கப்பட்டதும் அது நிறைவடையும்.</string>
    <string name="tip_jar_cleared">நிலுவையில் இருந்த உங்கள் டிப் நிறைவடைந்தது. உங்கள் ஆதரவுக்கு நன்றி!</string>
    <string name="tip_jar_error">ஏதோ தவறு நடந்தது. மீண்டும் முயலவும்.</string>
