    <string name="app_name">Basic Root Checker</string>

    <!-- Main Strings-->
    <string name="textView_Disclaimer"><![CDATA[இந்த ஆப்ஸ் உங்கள் சாதனத்தை <b>ரூட் செய்யாது</b>.<br>உங்கள் சாதனத்தில் ரூட் அணுகல் உள்ளதா என்பதை மட்டுமே இது காட்டும்.]]></string>
    <string name="textView_checkForRoot">ரூட் நிலையைச் சரிபார்க்க கீழ் வலதுபுறத்தில் உள்ள \"#\" பொத்தானைத் தட்டவும்</string>
    <string name="rootAvailable">உங்கள் சாதனத்தில் ரூட் அணுகல் உள்ளது</string>
    <string name="rootUnknown">உங்கள் சாதனத்தின் ரூட் நிலையைப் பெற முடியவில்லை</string>
    <string name="rootNotAvailable">உங்கள் சாதனத்தில் ரூட் அணுகல் இல்லை</string>
    <string name="rootNotGranted">ரூட் உள்ளது, ஆனால் இந்த ஆப்ஸுக்கு அணுகல் வழங்கப்படவில்லை</string>
    <string name="root_hidden_manager_hint">மறைக்கப்பட்ட அல்லது பெயர் மாற்றப்பட்ட ரூட் மேலாளரைப் (எடுத்துக்காட்டாக Kitsune Mask) பயன்படுத்துகிறீர்களா? இந்த ஆப்ஸுக்கு நீங்கள் அணுகல் வழங்கும் வரை அது கண்டறியப்படாமல் இருக்கலாம்.</string>
