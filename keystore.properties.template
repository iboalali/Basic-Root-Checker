# Release signing credentials for `./gradlew bundleGplayRelease`.
#
# Copy this file to keystore.properties (which is gitignored — never commit the real one) and fill in
# the four values. app/build.gradle.kts reads them, so a release build is signed without going
# through Android Studio's "Generate Signed App Bundle" wizard:
#
#     cp keystore.properties.template keystore.properties
#     ./gradlew :app:signingReport         # confirms the release config is picked up
#     ./gradlew :app:bundleGplayRelease    # -> app/build/outputs/bundle/gplayRelease/app-gplay-release.aab
#
# The signing config sits on the release *build type*, so it covers both flavors: bundleGplayRelease
# (the Play build) and bundleFossRelease. Only the gplay one is ever uploaded to Play.
#
# With none of these set the release build still succeeds but comes out UNSIGNED, which Play rejects
# on upload. CI can supply the same four values as the environment variables named below instead.
#
# These are the *upload key* credentials — the key Play verifies at upload. Play App Signing holds
# the app signing key itself, so losing this one is recoverable via Play Console; losing it still
# means requesting an upload-key reset, so keep the keystore backed up somewhere off this machine.

# Absolute path to the keystore, or a path relative to the repo root.
#                                                      env: BASIC_ROOT_CHECKER_STORE_FILE
storeFile=/absolute/path/to/upload-keystore.jks

# Password for the keystore file.                       env: BASIC_ROOT_CHECKER_STORE_PASSWORD
storePassword=

# Alias of the key inside the keystore.                 env: BASIC_ROOT_CHECKER_KEY_ALIAS
keyAlias=

# Password for that key (often the same as storePassword).
#                                                      env: BASIC_ROOT_CHECKER_KEY_PASSWORD
keyPassword=
