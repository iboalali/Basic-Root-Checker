# Built application files
*.apk
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Intellij
*.iml
.idea/workspace.xml
.idea/libraries

# Keystore files
*.jks
*.keystore

# Release signing — the real credentials, never committed. keystore.properties.template is.
/keystore.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
app/release/*
app/*/release/
app/src/main/res/values/publickey.xml
.idea/
/.kotlin/*

# Claude Code — commit the shared knowledge, ignore per-machine state.
# Tracked on purpose: settings.json (so a clone inherits the enabled plugins),
# agents/ and agent-memory/ (so an agent's accumulated knowledge isn't lost per clone).
/.claude/settings.local.json
/.claude/worktrees
